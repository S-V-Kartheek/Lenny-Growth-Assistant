# Where the browser reaches the FastAPI backend. The browser makes this
# request directly (not the dev server or the Docker container), so this must
# be an address the browser itself can resolve -- localhost:8000 works whether
# the frontend is run with `npm run dev` or as the `web` Compose service,
# because the API's port is published to the host either way.
VITE_API_BASE_URL=http://localhost:8000
