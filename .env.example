# ---------------------------------------------------------------------------
# Lenny Growth Assistant -- environment template
#
#   cp .env.example .env        # then edit only what you need
#
# Every value below is a SAFE DEFAULT that works with `docker compose up`.
# Nothing here is a secret. Real API keys go in .env, which is gitignored.
# ---------------------------------------------------------------------------

# === Required for the default local demo =================================== #
# Nothing. The defaults below run entirely on your machine with Ollama.

# === Application =========================================================== #
ENVIRONMENT=local
LOG_LEVEL=INFO
# json = machine-readable (default, what the container ships with)
# console = easier to read while developing
LOG_FORMAT=json
# Comma-separated. Never use "*" -- the API carries session identity.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Database ============================================================== #
# Inside docker compose the host is `db`; running the API on your host it is
# `localhost` (compose publishes 5432).
DATABASE_URL=postgresql+asyncpg://lenny:lenny@db:5432/lenny

# === Model provider ======================================================== #
# ollama (default, fully local) | anthropic | openai
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.3
# Local models are slow. 180s is generous on purpose; lower it for cloud.
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=2048
# Used only if the primary provider is unreachable AND this one is configured.
# Leave empty to fail loudly instead of silently switching models.
LLM_FALLBACK_PROVIDER=

# --- Ollama (local, used for the demo) ---
# From inside a container on Docker Desktop, the host is host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Must match the model's real context window; context budgeting relies on it.
# qwen2.5:7b-instruct = 32768,  phi3 = 4096,  llama3.1:8b = 131072
OLLAMA_CONTEXT_TOKENS=32768

# --- Anthropic (optional cloud provider) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (optional cloud provider) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === Embeddings ============================================================ #
# ollama | none.  With `none`, retrieval degrades to lexical-only search,
# which still works -- the UI and /health/detail will say it is degraded.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Changing the model usually changes this. The chunks.embedding column is typed
# to this width, so re-run ingestion after changing it.
EMBEDDING_DIMENSIONS=768
# Chunks embedded per request. Larger is ~2x faster; lower it if Ollama times
# out on a constrained machine.
EMBEDDING_BATCH_SIZE=128

# === Retrieval ============================================================= #
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=30
# Below this fused confidence the assistant says it has no supporting material
# instead of answering. Raise it to refuse more often, lower to answer more.
RETRIEVAL_MIN_CONFIDENCE=0.48
# Cap on passages from any single episode, so answers cite varied sources.
RETRIEVAL_MAX_PER_EPISODE=2

# === Ingestion ============================================================= #
CORPUS_REPO=ChatPRD/lennys-podcast-transcripts
# Pinned for reproducibility: every citation traces to this exact revision.
CORPUS_COMMIT=be8ab89a890a833cbba2c892178f823fff178c65
# Skip promo clips; index full interviews only.
INGEST_MIN_DURATION_SECONDS=1200
# Most-watched episodes first. Raise for more coverage, at the cost of a longer
# first-run ingestion (embedding is the slow part).
INGEST_MAX_EPISODES=40
INGEST_ALL=false
# Optional explicit allow-list of episode slugs; overrides the rules above.
INGEST_EPISODES=

# === Limits ================================================================ #
MAX_MESSAGE_CHARS=4000
RATE_LIMIT_PER_MINUTE=60
